# OilOps AI - git ignore

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.venv/
venv/
.env*
!.env.example

# SQLite (local dev DB; fixtures use synthetic data only)
*.db
*.db-journal
database/*.db
database/*.db-journal

# Streamlit
.streamlit/secrets.toml

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs / temp / debug
*.log
*.bak
*.tmp
*.swp
*.orig
debug/
temp/
.tmp/

# Synthetic data policy:
# sample_data/synthetic_invoices/ IS committed (synthetic fixtures only).
# Any real user-supplied PDFs MUST go into an ignored subfolder:
sample_data/user_uploads/
sample_data/real_uploads/
uploads/

# STEP 9 - Document Storage + Traceability.
# Real uploaded PDFs MUST land under data/documents/ which is local
# only. Never commit them.
data/

# Local-only artifacts (regenerated by tests)
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Hardening for portfolio release (V1.1.1)
*.sqlite
*.sqlite3

# Defensive: never commit populated databases.
demo_oilops.db
oilops.db

# OS-generated desktop junk
Desktop.ini

# Chinese folder containing the 15-PDF multi-layout synthetic set is
# committed (synthetic fixtures only).
!发票示例/**/*.pdf
!发票示例/**/*.csv
